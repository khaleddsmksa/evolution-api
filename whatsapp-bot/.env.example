# ============================================
#   إعدادات بوت واتساب (Evolution WhatsApp Bot)
# ============================================

# ---- خادم البوت ----
PORT=3001
# المسار الذي يستقبل عليه البوت الـ Webhook من Evolution API
WEBHOOK_PATH=/webhook

# ---- إعدادات الاتصال بـ Evolution API ----
# عنوان خادم Evolution API (مثال: http://localhost:8080)
EVOLUTION_API_URL=http://localhost:8080
# مفتاح الـ API العام (apikey header) الخاص بـ Evolution API
EVOLUTION_API_KEY=change-me-global-apikey
# اسم الـ instance (الجلسة) المتصلة بواتساب داخل Evolution
EVOLUTION_INSTANCE=mybot

# ---- إعدادات الذكاء الاصطناعي (اختياري) ----
# اتركه فارغاً لتعطيل ردود الـ AI والاكتفاء بالقائمة التفاعلية.
# ملاحظة: إذا كان متغيرا البيئة OPENAI_API_KEY و OPENAI_BASE_URL مضبوطين
# على مستوى النظام (كما في بيئة GenSpark)، فسيتم استخدامهما تلقائياً.
OPENAI_API_KEY=
# نموذج OpenAI القياسي: gpt-4o-mini
# نماذج بيئة GenSpark المدعومة: gpt-5-mini, gpt-5-nano, gpt-5, ...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- إعدادات عامة ----
# اسم النشاط التجاري الذي يظهر في الرسائل
BUSINESS_NAME=متجر إيفُليوشن
# لغة البوت الافتراضية (ar / en)
DEFAULT_LANG=ar
# وضع المحاكاة: true لاختبار البوت بدون خادم Evolution حقيقي
SIMULATION_MODE=false
